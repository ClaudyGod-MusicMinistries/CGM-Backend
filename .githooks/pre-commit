#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Pre-commit — fast checks on staged C# files only.
#
# Runs `dotnet format --verify-no-changes`, which fails (blocking the commit)
# if any staged file isn't correctly formatted, without silently rewriting
# your changes for you. Full build + test suite runs at push time instead —
# see .githooks/pre-push — since a full solution build isn't "fast".
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

HOOK_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$HOOK_DIR/lib/ui.sh"
hook_header "PRE-COMMIT  Fast staged-code review"

# Git hooks run with a leaner PATH than your interactive shell — dotnet may be
# on your PATH via ~/.zshrc or `brew shellenv`, neither of which non-login
# processes source. Try common install locations first (fast), then fall back
# to asking your actual login+interactive shell what its real PATH is — that
# shell is the one that successfully finds dotnet when you type it yourself,
# so this works regardless of how/where it's installed.
find_dotnet() {
  command -v dotnet >/dev/null 2>&1 && return 0

  local candidate
  for candidate in "$HOME/.dotnet" /usr/local/share/dotnet /usr/share/dotnet \
                   /opt/homebrew/opt/dotnet/libexec /usr/local/opt/dotnet/libexec; do
    if [[ -x "$candidate/dotnet" ]]; then
      export PATH="$candidate:$PATH"
      return 0
    fi
  done

  local user_shell raw shell_path
  user_shell="${SHELL:-/bin/zsh}"
  # Markers so any startup noise (MOTD, prompt themes, etc.) can't corrupt the
  # captured PATH — we only trust text between the two markers.
  raw="$("$user_shell" -ilc 'echo "@@PATH_START@@${PATH}@@PATH_END@@"' 2>/dev/null || true)"
  shell_path="$(echo "$raw" | sed -n 's/.*@@PATH_START@@\(.*\)@@PATH_END@@.*/\1/p')"
  if [[ -n "$shell_path" ]]; then
    export PATH="$shell_path:$PATH"
  fi

  command -v dotnet >/dev/null 2>&1
}

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Reject repository hygiene and accidental-secret failures before language checks.
if ! git diff --cached --check; then
  die "Staged changes contain whitespace errors or conflict markers."
fi

STAGED_FILES="$(git diff --cached --name-only --diff-filter=ACMR)"
if [[ -n "$STAGED_FILES" ]] && git diff --cached -- \
    $STAGED_FILES | grep -E '^\+.*(BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY|AKIA[0-9A-Z]{16}|sk_live_[0-9A-Za-z]+|password[[:space:]]*=[[:space:]]*[^$<{[:space:]]+)' >/dev/null; then
  die "Possible credential or private key detected in staged changes. Move secrets to the secret store."
fi

# Portable read loop instead of `mapfile` — macOS ships bash 3.2 by default,
# which predates mapfile/readarray (bash 4+ only).
STAGED_CS_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && STAGED_CS_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.cs')

if [[ ${#STAGED_CS_FILES[@]} -eq 0 ]]; then
  hook_success "No staged C# files required formatting."
  exit 0
fi

if ! find_dotnet; then
  die "dotnet SDK not found — checked common install locations, and even asked \$SHELL (${SHELL:-unset}) for its real PATH, with no luck. Run 'which dotnet' in your terminal and paste it back so the exact path can be hardcoded into find_dotnet(). To skip this check just once: git commit --no-verify."
fi

HOOK_FAILURE_HINT="Run dotnet format, review the result, and re-stage the files."
run_step "C# formatting (${#STAGED_CS_FILES[@]} staged files)" \
  dotnet format ClaudyGod.sln --verify-no-changes --include "${STAGED_CS_FILES[@]}"
hook_success "Commit approved."
