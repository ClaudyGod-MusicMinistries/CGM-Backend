#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Pre-commit — fast checks on staged C# files only.
#
# Runs `dotnet format --verify-no-changes`, which fails (blocking the commit)
# if any staged file isn't correctly formatted, without silently rewriting
# your changes for you. Full build + test suite runs at push time instead —
# see .githooks/pre-push — since a full solution build isn't "fast".
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

GREEN='\033[0;32m'; YELLOW='\033[1;33m'; RED='\033[0;31m'; NC='\033[0m'
info()    { echo -e "${GREEN}→${NC} $*"; }
warn()    { echo -e "${YELLOW}⚠${NC}  $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
die()     { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

# Git hooks run with a leaner PATH than your interactive shell — dotnet may be
# on your PATH via ~/.zshrc or `brew shellenv`, neither of which non-login
# processes source. Check the common install locations before giving up.
find_dotnet() {
  command -v dotnet >/dev/null 2>&1 && return 0
  local candidate
  for candidate in "$HOME/.dotnet" /usr/local/share/dotnet /usr/share/dotnet \
                   /opt/homebrew/opt/dotnet/libexec /usr/local/opt/dotnet/libexec; do
    if [[ -x "$candidate/dotnet" ]]; then
      export PATH="$candidate:$PATH"
      return 0
    fi
  done
  return 1
}

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

# Portable read loop instead of `mapfile` — macOS ships bash 3.2 by default,
# which predates mapfile/readarray (bash 4+ only).
STAGED_CS_FILES=()
while IFS= read -r line; do
  [[ -n "$line" ]] && STAGED_CS_FILES+=("$line")
done < <(git diff --cached --name-only --diff-filter=ACMR -- '*.cs')

if [[ ${#STAGED_CS_FILES[@]} -eq 0 ]]; then
  info "No staged .cs files — skipping format check."
  exit 0
fi

if ! find_dotnet; then
  die "dotnet SDK not found on PATH (checked \$HOME/.dotnet, /usr/local/share/dotnet, /usr/share/dotnet, and common Homebrew locations too). Run 'which dotnet' in your terminal to find where it actually lives, then either symlink it into /usr/local/bin, or add its directory to the find_dotnet() candidate list in .githooks/pre-commit and .githooks/pre-push. To skip this check just once: git commit --no-verify."
fi

info "Checking formatting on ${#STAGED_CS_FILES[@]} staged file(s)..."

if ! dotnet format ClaudyGod.sln --verify-no-changes --include "${STAGED_CS_FILES[@]}"; then
  echo ""
  die "Formatting issues found. Run 'dotnet format ClaudyGod.sln --include ${STAGED_CS_FILES[*]}', review the diff, re-stage, and commit again."
fi

success "Formatting OK."
