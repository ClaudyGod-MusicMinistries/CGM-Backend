#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Pre-push — thorough check: full solution build + full test suite.
#
# This is the last line of defense before code leaves your machine. It builds
# every project (Domain/Application/Infrastructure/API) and runs every test
# project (Domain.Tests/Application.Tests/Infrastructure.Tests). Mirrors the
# exact steps CI runs in .github/workflows/build-push.yml's `test` job, so a
# push that fails here would also have failed CI — you find out now, locally,
# instead of waiting on a red build.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

GREEN='\033[0;32m'; RED='\033[0;31m'; NC='\033[0m'
info()    { echo -e "${GREEN}→${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
die()     { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

# Git hooks run with a leaner PATH than your interactive shell — dotnet may be
# on your PATH via ~/.zshrc or `brew shellenv`, neither of which non-login
# processes source. Try common install locations first (fast), then fall back
# to asking your actual login+interactive shell what its real PATH is — that
# shell is the one that successfully finds dotnet when you type it yourself,
# so this works regardless of how/where it's installed.
find_dotnet() {
  command -v dotnet >/dev/null 2>&1 && return 0

  local candidate
  for candidate in "$HOME/.dotnet" /usr/local/share/dotnet /usr/share/dotnet \
                   /opt/homebrew/opt/dotnet/libexec /usr/local/opt/dotnet/libexec; do
    if [[ -x "$candidate/dotnet" ]]; then
      export PATH="$candidate:$PATH"
      return 0
    fi
  done

  local user_shell raw shell_path
  user_shell="${SHELL:-/bin/zsh}"
  # Markers so any startup noise (MOTD, prompt themes, etc.) can't corrupt the
  # captured PATH — we only trust text between the two markers.
  raw="$("$user_shell" -ilc 'echo "@@PATH_START@@${PATH}@@PATH_END@@"' 2>/dev/null || true)"
  shell_path="$(echo "$raw" | sed -n 's/.*@@PATH_START@@\(.*\)@@PATH_END@@.*/\1/p')"
  if [[ -n "$shell_path" ]]; then
    export PATH="$shell_path:$PATH"
  fi

  command -v dotnet >/dev/null 2>&1
}

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! find_dotnet; then
  die "dotnet SDK not found — checked common install locations, and even asked \$SHELL (${SHELL:-unset}) for its real PATH, with no luck. Run 'which dotnet' in your terminal and paste it back so the exact path can be hardcoded into find_dotnet(). To skip this check just once: git push --no-verify."
fi

info "Restoring..."
dotnet restore ClaudyGod.sln

info "Building (Release)..."
dotnet build ClaudyGod.sln --no-restore -c Release || die "Build failed. Fix the errors above before pushing."

info "Verifying formatting..."
dotnet format ClaudyGod.sln --no-restore --verify-no-changes || die "Formatting check failed. Run dotnet format ClaudyGod.sln."

info "Auditing dependencies..."
dotnet list ClaudyGod.sln package --vulnerable --include-transitive || die "Dependency audit failed."

info "Running full test suite..."
dotnet test ClaudyGod.sln --no-build -c Release --logger "console;verbosity=normal" || die "Tests failed. Fix the failing tests above before pushing."

success "Build and tests passed — pushing."
