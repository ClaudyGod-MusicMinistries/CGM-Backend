#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
# Pre-push — thorough check: full solution build + full test suite.
#
# This is the last line of defense before code leaves your machine. It builds
# every project (Domain/Application/Infrastructure/API) and runs every test
# project (Domain.Tests/Application.Tests/Infrastructure.Tests). Mirrors the
# exact steps CI runs in .github/workflows/build-push.yml's `test` job, so a
# push that fails here would also have failed CI — you find out now, locally,
# instead of waiting on a red build.
# ─────────────────────────────────────────────────────────────────────────────
set -euo pipefail

GREEN='\033[0;32m'; RED='\033[0;31m'; NC='\033[0m'
info()    { echo -e "${GREEN}→${NC} $*"; }
success() { echo -e "${GREEN}✓${NC} $*"; }
die()     { echo -e "${RED}✗${NC} $*" >&2; exit 1; }

# Git hooks run with a leaner PATH than your interactive shell — dotnet may be
# on your PATH via ~/.zshrc or `brew shellenv`, neither of which non-login
# processes source. Check the common install locations before giving up.
find_dotnet() {
  command -v dotnet >/dev/null 2>&1 && return 0
  local candidate
  for candidate in "$HOME/.dotnet" /usr/local/share/dotnet /usr/share/dotnet \
                   /opt/homebrew/opt/dotnet/libexec /usr/local/opt/dotnet/libexec; do
    if [[ -x "$candidate/dotnet" ]]; then
      export PATH="$candidate:$PATH"
      return 0
    fi
  done
  return 1
}

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

if ! find_dotnet; then
  die "dotnet SDK not found on PATH (checked \$HOME/.dotnet, /usr/local/share/dotnet, /usr/share/dotnet, and common Homebrew locations too). Run 'which dotnet' in your terminal to find where it actually lives, then either symlink it into /usr/local/bin, or add its directory to the find_dotnet() candidate list in .githooks/pre-commit and .githooks/pre-push. To skip this check just once: git push --no-verify."
fi

info "Restoring..."
dotnet restore ClaudyGod.sln

info "Building (Release)..."
dotnet build ClaudyGod.sln --no-restore -c Release || die "Build failed. Fix the errors above before pushing."

info "Running full test suite..."
dotnet test ClaudyGod.sln --no-build -c Release --logger "console;verbosity=normal" || die "Tests failed. Fix the failing tests above before pushing."

success "Build and tests passed — pushing."
